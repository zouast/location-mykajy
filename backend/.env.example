# App Settings
PORT=3000
NODE_ENV=development

# Database Settings
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_strong_password
DATABASE_NAME=mykajy_db
DATABASE_URL="postgresql://postgres:your_strong_password@localhost:5432/mykajy_db?schema=public"

# Auth JWT Settings
JWT_SECRET=change_me_to_a_very_long_and_secure_random_string_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_different_refresh_secret_at_least_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# Frontend (liens email de vérification / reset)
FRONTEND_URL=http://localhost:4200

# Token expiration (hours)
PASSWORD_RESET_EXPIRES_HOURS=1
EMAIL_VERIFICATION_EXPIRES_HOURS=24
BCRYPT_SALT_ROUNDS=10
